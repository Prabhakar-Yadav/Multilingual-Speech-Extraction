# =============================================================================
# VaultStack — Multilingual Medical Speech Extraction
# GitHub-ready .gitignore
#
# Do NOT commit: secrets, caches, virtualenvs, model weights, training
# checkpoints, or generated outputs.
#
# Model weights are downloaded separately (see README.md "Setup" and
# src/download_model.py). Generated outputs are recreated by running the
# pipeline in src/.
# =============================================================================

# --- Secrets / environment ---------------------------------------------------
.env
.env.*
*.env
.env.local
.env.*.local
secrets/
.secrets/
config.secret.json

# NOTE: .env contains real API keys (GROQ / SARVAM). Keep it out of git and
# rotate those keys if they were ever accidentally committed.

# --- Python ------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.venv*/
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.egg-info/
*.eggs/
*.egg
.installed.cfg
.pytest_cache/
.mypy_cache/
.pyrightcache
.tox/
.coverage
coverage.xml
htmlcov/
.python-version
pip-log.txt
pip-delete-this-directory.txt

# --- Jupyter / notebooks -----------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints
checkpoint.ipynb

# --- IDE / editor ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.*.sw[npo]
*.tmp
*.bak

# --- OS ----------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Logs --------------------------------------------------------------------
*.log
train_log.txt
train_max_log.txt
*.debug.log

# --- Model weights / binaries (re-download; do not track) --------------------
# Large weight files anywhere in the repo
*.safetensors
*.bin
*.gguf
*.onnx
*.pkl
*.pt
optimizer.pt
adapter_model.safetensors
adapter_config.json

# Model directories downloaded via src/download_model.py (see README.md)
models/
Bengali/models/
Bengali/ASR/models/
Hindi/models/

# llama.cpp bundled binaries (see requirements_deploy.txt) — large, platform-specific
*.dll
*.exe

# --- Training checkpoints (generated) ----------------------------------------
**/checkpoint-*/
**/runs/
runs/

# --- Generated outputs / transcripts (regenerated by pipeline) ---------------
outputs/
outputs_audio/
Bengali/outputs*/
Bengali/ASR/outputs*/
Hindi/outputs/
English ASR/outputs/

# --- Archives ----------------------------------------------------------------
*.zip
*.7z
*.rar
*.tar.gz
outputs.zip

# =============================================================================
# IMPORTANT — review before pushing to a public repo:
#  - call transcription.docx may contain patient call data (PII/PHI).
#    Remove it or keep the repo private if it holds real patient info.
#  - .env keys above are gitignored, but rotate them anyway if they were ever
#    exposed.
# =============================================================================
